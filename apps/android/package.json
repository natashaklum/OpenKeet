{
  "name": "@openkeet/android",
  "version": "0.1.0",
  "description": "OpenKeet Android client (Capacitor + Vite + React, shares @openkeet/core)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/bundle-vendor.mjs --src ../../vendor/keet-orig --out dist",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run lint && echo android-smoke-ok",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@openkeet/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
